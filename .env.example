# Copy to .env and fill in. NEVER commit .env.
# Loaded by config/settings.py (pydantic-settings); unset keys fall back to
# the local-dev defaults there (which match docker-compose.yml).

# OpenRouter — one key covers LLM, STT, and TTS (design doc §10.1)
OPEN_ROUTER_API_KEY=

# Web search (spec §15) — needed when that module is built
SERPER_API_KEY=
BRAVE_API_KEY=

# Datastore connection strings — needed when Database Layer (§1) is built
MONGO_URI=
QDRANT_URL=
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
REDIS_URL=
