# Copy to .env and fill in. NEVER commit .env.
# Loaded by config/settings.py (pydantic-settings); unset keys fall back to
# the local-dev defaults there (which match docker-compose.yml).

# OpenRouter — covers LLM (chat/completions) + embeddings routing (design §10.1)
OPEN_ROUTER_API_KEY=

# xAI — Grok Voice TTS (§23), POST https://api.x.ai/v1/tts. Required for voice.
X-AI-API=

# Web search (spec §15)
SERPER_API_KEY=
BRAVE_API_KEY=

# STT model size (§20 faster-whisper local): tiny|base|small|medium.
# tiny/base are fast on CPU; leave unset for the default (base).
STT_MODEL_SIZE=

# Datastore connection strings — needed when Database Layer (§1) is built
MONGO_URI=
QDRANT_URL=
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
REDIS_URL=

# ── Auth: Google SSO + sessions (design §18/§26) ────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# PUBLIC url the browser + Google see (behind the reverse proxy). The OAuth
# redirect URI is built from this → <PUBLIC_BASE_URL>/auth/google/callback.
# Register that exact URI in the Google Cloud Console. Local dev: http://localhost:8000
PUBLIC_BASE_URL=https://202-58-120-93.sslip.io
# Strong random string — signs the session cookie. Generate: `openssl rand -hex 32`
SESSION_SECRET=
# DEV/TEST ONLY — bypass Google auth and resolve every request to this user_id so
# the UI can be driven locally (the secure session cookie can't ride http://localhost).
# LEAVE UNSET / EMPTY IN PROD. Example for local UI work: DEV_AUTH_USER=u_demo_001
# DEV_AUTH_USER=

# ── Welcome email (fastapi-mail via Gmail SMTP) ─────────────────────────────
# Gmail requires an APP PASSWORD (2FA must be enabled) — the normal account
# password will NOT work. Leave MAIL_* empty to disable sending (outbox still records).
MAIL_USERNAME=rabin.bhandari999@gmail.com            # the gmail address, e.g. you@gmail.com
MAIL_PASSWORD=            # a Google App Password (16 chars), NOT your login password
MAIL_FROM=               # from address (usually same as MAIL_USERNAME)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
