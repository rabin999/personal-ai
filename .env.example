# Copy to .env and fill in. NEVER commit .env.
# Loaded by config/settings.py (pydantic-settings); unset keys fall back to
# the local-dev defaults there (which match docker-compose.yml).

# OpenRouter — covers LLM (chat/completions) + embeddings routing (design §10.1)
OPEN_ROUTER_API_KEY=

# xAI — Grok Voice TTS (§23), POST https://api.x.ai/v1/tts. Required for voice.
X-AI-API=

# Web search (spec §15)
SERPER_API_KEY=
BRAVE_API_KEY=

# STT model size (§20 faster-whisper local): tiny|base|small|medium.
# tiny/base are fast on CPU; leave unset for the default (base).
STT_MODEL_SIZE=

# Datastore connection strings — needed when Database Layer (§1) is built
MONGO_URI=
QDRANT_URL=
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
REDIS_URL=
